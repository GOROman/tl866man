@@ -28,6 +28,29 @@
 
 #define HITACHI_MASK_PROM_MASK 0x80
 
+/* TL866man can slow the read-only bit-bang path for marginal sockets. */
+static unsigned int tl866man_read_delay_us(void)
+{
+	static int initialized;
+	static unsigned int delay;
+	if (!initialized) {
+		const char *value = getenv("TL866MAN_READ_DELAY_US");
+		if (value && *value)
+			delay = (unsigned int)strtoul(value, NULL, 10);
+		if (delay > 1000000)
+			delay = 1000000;
+		initialized = 1;
+	}
+	return delay;
+}
+
+static void tl866man_read_delay(void)
+{
+	unsigned int delay = tl866man_read_delay_us();
+	if (delay)
+		usleep(delay);
+}
